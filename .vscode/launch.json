{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Mac: C++ Debug current file",
            "type": "lldb",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "cwd": "${fileDirname}",
            "preLaunchTask": "Mac: clang++ build active file"
        },
        {
            "name": "Mac: Debug run.cpp (FP32)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/cpu/runcpp_dbg",
            "args": [
                "models/stories15M.bin",
                "-t", "0.0",
                "-n", "64",
                "-s", "42",
                "-i", "Once upon a time"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Mac: build runcpp_dbg"
        },
        {
            "name": "Mac: Debug runq.cpp (int8)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/cpu/runqcpp_dbg",
            "args": [
                "models/stories15M-q32.bin",
                "-t", "0.0",
                "-n", "64",
                "-s", "42",
                "-i", "Once upon a time"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Mac: build runqcpp_dbg"
        },
        {
            "name": "Linux: C++ Debug current file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "cwd": "${fileDirname}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Linux: g++-12 build active file"
        },
        {
            "name": "Linux: Debug run.cpp (FP32)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/cpu/runcpp_dbg",
            "args": [
                "models/stories15M.bin",
                "-t", "0.0",
                "-n", "64",
                "-s", "42",
                "-i", "Once upon a time"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Linux: build runcpp_dbg"
        },
        {
            "name": "Linux: Debug runq.cpp (int8)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/cpu/runqcpp_dbg",
            "args": [
                "models/stories15M-q32.bin",
                "-t", "0.0",
                "-n", "64",
                "-s", "42",
                "-i", "Once upon a time"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Linux: build runqcpp_dbg"
        },
        {
            "name": "cuda: Debug current file",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [
                "${workspaceFolder}/models/stories15M.bin",
                "-z", "${workspaceFolder}/models/tokenizer.bin",
                "-t", "0.0",
                "-n", "64",
                "-s", "42",
                "-i", "Once upon a time"
            ],
            "cwd": "${fileDirname}",
            "stopAtEntry": true,
            "debuggerPath": "/usr/local/cuda-12.8/bin/cuda-gdb",
            "preLaunchTask": "cuda: nvcc build active file"
        },
        {
            "name": "cuda: Debug rungpu (FP32)",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${workspaceFolder}/gpu/rungpu_dbg",
            "args": [
                "models/stories15M.bin",
                "-t", "0.0",
                "-n", "64",
                "-s", "42",
                "-i", "Once upon a time"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "debuggerPath": "/usr/local/cuda-12.8/bin/cuda-gdb",
            "preLaunchTask": "cuda: build rungpu_dbg"
        },
        {
            "name": "cuda: Debug runqgpu (int8)",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${workspaceFolder}/gpu/runqgpu_dbg",
            "args": [
                "models/stories15M-q32.bin",
                "-t", "0.0",
                "-n", "64",
                "-s", "42",
                "-i", "Once upon a time"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "debuggerPath": "/usr/local/cuda-12.8/bin/cuda-gdb",
            "preLaunchTask": "cuda: build runqgpu_dbg"
        }
    ]
}
