{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Debug: current file",
            "type": "lldb",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "cwd": "${fileDirname}",
            "preLaunchTask": "C/C++: clang++ build active file"
        },
        {
            "name": "Debug run.cpp (FP32)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/runcpp_dbg",
            "args": [
                "stories15M.bin",
                "-t", "0.0",
                "-n", "64",
                "-s", "42",
                "-i", "Once upon a time"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build runcpp_dbg"
        },
        {
            "name": "Debug runq.cpp (int8)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/runqcpp_dbg",
            "args": [
                "stories15M-q32.bin",
                "-t", "0.0",
                "-n", "64",
                "-s", "42",
                "-i", "Once upon a time"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build runqcpp_dbg"
        }
    ]
}
